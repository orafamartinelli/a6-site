# Gerado por scripts/gerar.mjs — Hostinger (Apache)
Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# endereços antigos do WordPress
RewriteRule ^eventos/?$ /programacao-e-ingressos/ [L,R=301]
RewriteRule ^mesas/?$ /programacao-e-ingressos/ [L,R=301]
RewriteRule ^mesas-e-lounges/?$ /programacao-e-ingressos/ [L,R=301]
RewriteRule ^precos/?$ /leve-um-show-para-sua-cidade/ [L,R=301]
RewriteRule ^servicos/?$ /leve-um-show-para-sua-cidade/ [L,R=301]
RewriteRule ^projetos/?$ /leve-um-show-para-sua-cidade/ [L,R=301]
RewriteRule ^comercial/?$ /leve-um-show-para-sua-cidade/ [L,R=301]
RewriteRule ^artistas-e-projetos/?$ /leve-um-show-para-sua-cidade/ [L,R=301]
RewriteRule ^superia-rock/?$ /vivasuperia/ [L,R=301]
RewriteRule ^eventos/superia-rock-humberto-gessinger-foz-do-iguacu/?$ /programacao-e-ingressos/ [L,R=301]
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^category/destaque/?$ /imprensa/ [L,R=301]
RewriteRule ^category/shows/?$ /imprensa/ [L,R=301]
RewriteRule ^category/uncategorized/?$ /imprensa/ [L,R=301]
RewriteRule ^wp-admin/?.*$ / [L,R=302]
RewriteRule ^feed/?$ /imprensa/ [L,R=301]
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
</IfModule>
